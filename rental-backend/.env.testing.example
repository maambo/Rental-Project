APP_NAME=Laravel
APP_ENV=testing
APP_KEY=base64:REPLACE_WITH_YOUR_APP_KEY
APP_DEBUG=false
APP_URL=http://rental-backend.test

LOG_CHANNEL=null
LOG_LEVEL=warning

# ── Database ───────────────────────────────────────────────────────────────
# Option A (default): dedicated SQLite file — no MySQL required
DB_CONNECTION=sqlite
DB_DATABASE=database/testing.sqlite

# Option B: MySQL test database (create it first):
#   CREATE DATABASE rental_backend_test CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=rental_backend_test
# DB_USERNAME=root
# DB_PASSWORD=

# ── Overrides ─────────────────────────────────────────────────────────────
SESSION_DRIVER=array
BROADCAST_CONNECTION=null
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=array
MAIL_MAILER=array
